# LangGraph checkpointer hardening: reject unsafe msgpack modules (CVE-2026-28277 / CVE-2026-27794)
LANGGRAPH_STRICT_MSGPACK=true

# Local inference endpoint (OpenAI-compatible llama.cpp server). Used by --llm llama.
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=llama-3-8b-instruct

# Optional: point at a directory of JSON fixtures to simulate scanner output
# without installing binaries. Each file must be named gitleaks.json / trivy.json.
EDGE_FAKE_SCAN_DIR=
